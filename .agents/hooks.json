{
  "msa-toolguard-guards": {
    "PreToolUse": [
      {
        "matcher": "run_command|read_file|view_file|edit_file|write_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/core_purity_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ./hooks/stop_contract_verify.py",
        "timeout": 20
      }
    ]
  }
}
